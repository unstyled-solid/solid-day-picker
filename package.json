{
  "name": "daypicker-solid2-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "test": "CI=true vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "verify:packed": "node scripts/verify-packed.mjs",
    "verify:source": "node scripts/verify-source.mjs",
    "verify:react": "node scripts/verify-react-oracle.mjs",
    "docs:api": "node docs/scripts/api.mjs",
    "docs:prepare": "node docs/scripts/prepare.mjs",
    "docs:dev": "vite --config docs/vite.config.ts",
    "docs:serve": "vite preview --config docs/vite.config.ts --port 3001",
    "docs:types": "tsc -p docs/tsconfig.json",
    "docs:build": "pnpm build && pnpm docs:api && pnpm docs:prepare && node docs/scripts/build.mjs",
    "docs:check": "node docs/scripts/check.mjs",
    "docs:test:smoke": "node docs/scripts/smoke.mjs",
    "docs:deploy": "pnpm docs:build && pnpm docs:check && pnpm dlx netlify-cli deploy --no-build --dir docs/generated/site",
    "docs:deploy:prod": "pnpm docs:deploy --prod",
    "release:npm": "node scripts/release.mjs",
    "release:test": "node --test scripts/release.test.mjs",
    "docs:test:browser": "node docs/scripts/browser.mjs",
    "test:timezone": "CI=true vitest run --config vitest.timezone.config.ts",
    "dev": "vite"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@mdx-js/mdx": "3.1.1",
    "prismjs": "1.30.0",
    "@types/prismjs": "1.26.5",
    "mockdate": "3.0.5",
    "@mdx-js/rollup": "3.1.1",
    "remark-gfm": "4.0.1",
    "unified": "11.0.5",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-directive": "4.0.0",
    "unist-util-visit": "5.0.0",
    "gray-matter": "4.0.3",
    "typedoc": "0.28.19",
    "typedoc-plugin-markdown": "4.11.0",
    "infima": "0.2.0-alpha.45",
    "ts-morph": "27.0.2",
    "date-fns-jalali": "4.1.0-0",
    "@tabby_ai/hijri-converter": "1.0.5",
    "@solidjs/babel-plugin": "2.0.0-rc.13",
    "@solidjs/compiler": "2.0.0-rc.13",
    "@solidjs/signals": "2.0.0-rc.13",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@solidjs/web": "2.0.0-rc.13",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "@types/babel__core": "7.20.5",
    "@types/node": "25.5.0",
    "date-fns": "4.1.0",
    "@date-fns/tz": "1.4.1",
    "jsdom": "27.4.0",
    "solid-js": "2.0.0-rc.13",
    "@solid-unstyled/daypicker": "workspace:*",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "playwright": "1.63.0"
  }
}
