{
  "name": "@solid-unstyled/daypicker",
  "version": "10.0.2-solid.0",
  "description": "Customizable date pickers and calendars for Solid 2, based on React DayPicker",
  "repository": { "type": "git", "url": "git+https://github.com/unstyled-solid/solid-day-picker.git", "directory": "packages/solid" },
  "homepage": "https://github.com/unstyled-solid/solid-day-picker#readme",
  "bugs": { "url": "https://github.com/unstyled-solid/solid-day-picker/issues" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "license": "MIT",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "src/*.css", "src/*.css.d.ts", "LICENSE", "NOTICE", "README.md"],
  "peerDependencies": { "solid-js": "2.0.0-rc.20", "@solidjs/web": "2.0.0-rc.20" },
  "dependencies": { "@date-fns/tz": "1.4.1", "date-fns": "4.1.0", "date-fns-jalali": "4.1.0-0", "@tabby_ai/hijri-converter": "1.0.5" },
  "exports": {
    ".": { "types": "./dist/types/index.d.ts", "worker": "./dist/server/index.js", "browser": "./dist/dom/index.js", "deno": "./dist/server/index.js", "node": "./dist/server/index.js", "default": "./dist/server/index.js" },
    "./core": { "types": "./dist/types/index.d.ts", "worker": "./dist/server/index.js", "browser": "./dist/dom/index.js", "default": "./dist/server/index.js" },
    "./locale": { "types": "./dist/types/locale.d.ts", "default": "./dist/dom/locale.js" },
    "./buddhist": { "types": "./dist/types/calendars/buddhist/index.d.ts", "worker": "./dist/server/calendars/buddhist/index.js", "browser": "./dist/dom/calendars/buddhist/index.js", "default": "./dist/server/calendars/buddhist/index.js" },
    "./ethiopic": { "types": "./dist/types/calendars/ethiopic/index.d.ts", "worker": "./dist/server/calendars/ethiopic/index.js", "browser": "./dist/dom/calendars/ethiopic/index.js", "default": "./dist/server/calendars/ethiopic/index.js" },
    "./hebrew": { "types": "./dist/types/calendars/hebrew/index.d.ts", "worker": "./dist/server/calendars/hebrew/index.js", "browser": "./dist/dom/calendars/hebrew/index.js", "default": "./dist/server/calendars/hebrew/index.js" },
    "./hijri": { "types": "./dist/types/calendars/hijri/index.d.ts", "worker": "./dist/server/calendars/hijri/index.js", "browser": "./dist/dom/calendars/hijri/index.js", "default": "./dist/server/calendars/hijri/index.js" },
    "./persian": { "types": "./dist/types/calendars/persian/index.d.ts", "worker": "./dist/server/calendars/persian/index.js", "browser": "./dist/dom/calendars/persian/index.js", "default": "./dist/server/calendars/persian/index.js" },
    "./locale/*": { "types": "./dist/types/locale/*.d.ts", "default": "./dist/dom/locale/*.js" },
    "./style.css": { "types": "./src/style.css.d.ts", "default": "./src/style.css" },
    "./style.module.css": { "types": "./src/style.module.css.d.ts", "default": "./src/style.module.css" },
    "./style": { "sass": "./src/style.css" },
    "./style.module": { "sass": "./src/style.module.css" },
    "./src/style.css": "./src/style.css",
    "./src/style.module.css": "./src/style.module.css",
    "./dist/style.css": "./src/style.css",
    "./dist/style.module.css": "./src/style.module.css",
    "./package.json": "./package.json"
  }
}
