{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": { "@/test/*": ["test/*"] },
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["packages/solid/src", "test", "examples", "vitest.config.ts", "vite.config.ts"]
}
